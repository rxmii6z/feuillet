{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feuillet",
  "version": "1.0.0",
  "identifier": "fr.feuillet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Feuillet",
        "width": 1360,
        "height": 900,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false,
        "windowEffects": { "effects": ["mica"] },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=msOverlayScrollbarWinStyle,msOverlayScrollbarWinStyleAnimation"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["**"] },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
